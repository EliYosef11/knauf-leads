{
  "name": "NotificationSettings",
  "type": "object",
  "properties": {
    "notification_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05de\u05d9\u05d9\u05dc \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05e2\u05dc \u05dc\u05d9\u05d3\u05d9\u05dd \u05d7\u05d3\u05e9\u05d9\u05dd"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05e9\u05dc\u05d9\u05d7\u05ea \u05de\u05d9\u05d9\u05dc\u05d9\u05dd"
    },
    "label": {
      "type": "string",
      "description": "\u05ea\u05d5\u05d5\u05d9\u05ea \u05dc\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea"
    },
    "reminder_days": {
      "type": "number",
      "default": 7,
      "description": "\u05d0\u05d7\u05e8\u05d9 \u05db\u05de\u05d4 \u05d9\u05de\u05d9\u05dd \u05dc\u05e9\u05dc\u05d5\u05d7 \u05ea\u05d6\u05db\u05d5\u05e8\u05ea \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05dc\u05d9\u05d3"
    }
  },
  "required": []
}