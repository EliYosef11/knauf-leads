{
  "name": "Lead",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05dc\u05d0"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d3\u05d5\u05d0\"\u05dc"
    },
    "company": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d7\u05d1\u05e8\u05d4"
    },
    "city": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e8"
    },
    "role": {
      "type": "string",
      "enum": [
        "\u05d0\u05d3\u05e8\u05d9\u05db\u05dc",
        "\u05e7\u05d1\u05dc\u05df",
        "\u05de\u05e4\u05e7\u05d7",
        "\u05d9\u05d6\u05dd",
        "\u05de\u05e2\u05e6\u05d1 \u05e4\u05e0\u05d9\u05dd",
        "\u05de\u05d4\u05e0\u05d3\u05e1",
        "\u05d0\u05d7\u05e8"
      ],
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3"
    },
    "project_handling": {
      "type": "string",
      "description": "\u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "\u05ea\u05e7\u05e8\u05d5\u05ea",
          "\u05dc\u05d5\u05d7\u05d5\u05ea",
          "\u05d0\u05e7\u05d5\u05d5\u05d4 \u05e4\u05d0\u05e0\u05dc",
          "\u05d1\u05d9\u05d3\u05d5\u05d3",
          "\u05de\u05e8\u05de\u05d5\u05e8\u05d9\u05d8",
          "\u05de\u05d5\u05e6\u05e8\u05d9 \u05d2\u05de\u05e8",
          "\u05e7\u05e8\u05e0\u05d9\u05d6\u05d9\u05dd",
          "\u05de\u05ea\u05e7\u05e0\u05d9 \u05ea\u05dc\u05d9\u05d4",
          "\u05e4\u05ea\u05d7\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea",
          "\u05d0\u05d7\u05e8"
        ]
      },
      "description": "\u05ea\u05d7\u05d5\u05de\u05d9 \u05e2\u05e0\u05d9\u05d9\u05df"
    },
    "event_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05db\u05e0\u05e1 (\u05de\u05e9\u05d5\u05d9\u05da \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05dc\u05e4\u05d9 \u05d4\u05ea\u05d0\u05e8\u05d9\u05da)"
    },
    "event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05db\u05e0\u05e1 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d5\u05d9\u05da \u05d4\u05dc\u05d9\u05d3"
    },
    "campaign_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df (\u05dc\u05d9\u05d3\u05d9\u05dd \u05de-Meta)"
    },
    "campaign_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05de\u05e4\u05d9\u05d9\u05df \u05e9\u05de\u05de\u05e0\u05d5 \u05d4\u05d2\u05d9\u05e2 \u05d4\u05dc\u05d9\u05d3"
    },
    "lead_source": {
      "type": "string",
      "enum": [
        "\u05db\u05e0\u05e1",
        "meta",
        "\u05d9\u05d3\u05e0\u05d9"
      ],
      "default": "\u05db\u05e0\u05e1",
      "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05dc\u05d9\u05d3"
    },
    "rep_notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e0\u05e6\u05d9\u05d2"
    },
    "assigned_to": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d4\u05dc\u05d9\u05d3 \u05de\u05d5\u05e2\u05d1\u05e8 \u05dc\u05d8\u05d9\u05e4\u05d5\u05dc"
    },
    "assigned_email": {
      "type": "string",
      "description": "\u05de\u05d9\u05d9\u05dc \u05d4\u05e0\u05e6\u05d9\u05d2 \u05e9\u05de\u05d8\u05e4\u05dc"
    },
    "lead_summary": {
      "type": "string",
      "description": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e9\u05d9\u05d7\u05d4/\u05e4\u05d2\u05d9\u05e9\u05d4 \u05e2\u05dd \u05d4\u05dc\u05d9\u05d3"
    },
    "is_quality": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05dc\u05d9\u05d3 \u05d0\u05d9\u05db\u05d5\u05ea\u05d9"
    },
    "crm_entered": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05dc\u05d9\u05d3 \u05d4\u05d5\u05d6\u05df \u05d1-CRM"
    },
    "status": {
      "type": "string",
      "enum": [
        "\u05d8\u05e8\u05dd \u05d8\u05d5\u05e4\u05dc",
        "\u05d8\u05d5\u05e4\u05dc"
      ],
      "default": "\u05d8\u05e8\u05dd \u05d8\u05d5\u05e4\u05dc",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d8\u05d9\u05e4\u05d5\u05dc \u05d1\u05dc\u05d9\u05d3"
    },
    "transfer_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from_rep": {
            "type": "string"
          },
          "to_rep": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e2\u05d1\u05e8\u05d5\u05ea \u05d4\u05dc\u05d9\u05d3 \u05d1\u05d9\u05df \u05e0\u05e6\u05d9\u05d2\u05d9\u05dd"
    },
    "reminder_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sent_at": {
            "type": "string"
          },
          "triggered_by": {
            "type": "string"
          }
        }
      },
      "description": "\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05e9\u05dc\u05d9\u05d7\u05ea \u05ea\u05d6\u05db\u05d5\u05e8\u05d5\u05ea \u05dc\u05e0\u05e6\u05d9\u05d2"
    }
  },
  "required": [
    "full_name",
    "phone"
  ]
}