{
  "name": "Representative",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2"
    },
    "email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05dc\u05e7\u05d1\u05dc\u05ea \u05d4\u05dc\u05d9\u05d3\u05d9\u05dd \u05e9\u05de\u05e9\u05d5\u05d9\u05db\u05d9\u05dd \u05d0\u05dc\u05d9\u05d5"
    },
    "role_title": {
      "type": "string",
      "description": "\u05ea\u05e4\u05e7\u05d9\u05d3 \u05d4\u05e0\u05e6\u05d9\u05d2"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e0\u05e6\u05d9\u05d2 \u05e4\u05e2\u05d9\u05dc \u05d5\u05de\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e8\u05e9\u05d9\u05de\u05d4"
    },
    "sort_order": {
      "type": "number",
      "description": "\u05e1\u05d3\u05e8 \u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "name"
  ]
}